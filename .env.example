# Local development: copy to .env. Replace every credential before sharing a deployment.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
TENANT_TOKENS=demo:local-demo-token
WORKER_TOKEN=local-worker-token
LEASE_MS=15000
WORKER_POLL_SECONDS=0.5
EMBEDDED_WORKER=1
# Optional OpenAI-compatible /v1 endpoint; basic startup needs no model key.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
